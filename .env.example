# Between — example environment. Copy to .env.ahmad (or the household's name)
# and adjust. scripts/dev.ts builds most of these for the four local homes.

# Identity
HOUSEHOLD=ahmad
PORT=4001
PUBLIC_URL=http://127.0.0.1:4001

# Storage
DB_PATH=data/ahmad.db
KEYS_DIR=data/keys

# Pin "today" so seeds, tests and recordings are reproducible. Unset = real time.
DEMO_NOW=2026-10-17T09:00:00-07:00

# Access
MCP_TOKEN=dev-token
# When set, /api/* and /sim/* require HTTP Basic (any user, this password).
DEMO_PASSCODE=

# Agent behaviour
# rules  = deterministic top-ranked move (no AWS needed)
# claude = Claude on Amazon Bedrock with the rules chooser as fallback
CHOOSER=rules
BETWEEN_MODEL=anthropic.claude-opus-5-5
AWS_REGION=us-east-1

# Watchability and timing
# PACE_MS: pause before each agent reply (~1200 looks good on camera, 0 in tests)
PACE_MS=0
# COLLECT_MS: how long the initiator waits for peers before settling
COLLECT_MS=4000
PEER_TIMEOUT_MS=5000

# Trusted families, as JSON. scripts/dev.ts builds this automatically for the
# four local households; on a host it is set per deployment.
# PEERS=[{"id":"park","name":"Park","url":"http://127.0.0.1:4002","publicKey":"<base64url>"}]
