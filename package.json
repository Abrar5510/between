{
  "name": "between",
  "version": "0.0.0",
  "private": true,
  "description": "Your Alexa negotiates with other families' Alexas, so you don't have to send the group text.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present && node --import tsx --test test/mcp.test.ts test/engine.test.ts",
    "e2e": "node --import tsx --test test/e2e.test.ts test/sim.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.sim.config.ts",
    "start": "tsx src/main.ts",
    "dev": "tsx scripts/dev.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^7",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  }
}
